{
  "name": "@matuto-ai/antigravity-psst-connector",
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "find src bin test vendor scripts -name \"*.mjs\" -print0 | xargs -0 -r -n1 node --check"
  },
  "license": "MIT",
  "description": "Native Antigravity Psst setup and conversation messaging with private administrator-approved installation credentials.",
  "bin": {
    "psst-antigravity": "bin/psst-antigravity.mjs",
    "psst-antigravity-native-plugin": "scripts/prepare-native-plugin.mjs"
  },
  "files": [
    "bin/psst-antigravity.mjs",
    "bin/psst-antigravity-native.mjs",
    "scripts/prepare-native-plugin.mjs",
    "src/**/*.mjs",
    "vendor/psst/**",
    "docs/installation.md",
    "docs/pairing.md",
    "docs/release.md",
    "plugin.json",
    "mcp_config.json",
    "hooks.json",
    "skills/**",
    "docs/setup.md",
    "docs/message-lifecycle.md",
    "docs/receive-presentation.md",
    "docs/migration-0.6.0.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matuto-ai/antigravity-psst-connector.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "antigravity",
    "mcp",
    "psst",
    "agent-messaging"
  ]
}
